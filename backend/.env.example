NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hotelflow
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_secret
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_secret
OPENAI_API_KEY=your_openai_api_key

# --- Auth & security ---
# Long random string used to sign login tokens (JWT). Generate e.g. with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=7d
# Admin bootstrap: run `npm run seed:admin` after setting these.
ADMIN_EMAIL=admin@ospitara.de
ADMIN_PASSWORD=change_me_min_8_chars
ADMIN_NAME=Admin
# Shared secret the inbound mail webhook must include (?token=... or X-Webhook-Token header).
INBOUND_WEBHOOK_SECRET=your_webhook_secret
# Comma-separated list of allowed browser origins (frontend URLs). Locks CORS in prod.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- Outbound mail (reply function) ---
# Transport is chosen by which vars are set: SES → Resend → SMTP.
# All HTTPS options work on hosts that block SMTP (Railway).

# Preferred long-term: Amazon SES (HTTPS API, cheapest at scale, no monthly cap).
# Verify the sender domain in SES, leave the sandbox, create an IAM user with
# ses:SendEmail permission, then set the three vars below.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
MAIL_FROM=Ospitara <info@ospitara.de>

# Alternative: Resend (HTTPS API). Only used if AWS keys are NOT set.
RESEND_API_KEY=your_resend_api_key

# Fallback: SMTP (e.g. Zoho). Only used if RESEND_API_KEY is NOT set.
# NOTE: Railway blocks outbound SMTP ports (465/587) → use Resend there.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=info@ospitara.de
SMTP_PASS=your_zoho_app_password
