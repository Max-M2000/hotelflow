NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hotelflow
GMAIL_CLIENT_ID=your_google_client_id
GMAIL_CLIENT_SECRET=your_google_secret
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_secret
OPENAI_API_KEY=your_openai_api_key

# --- Outbound mail (reply function) ---
# Zoho (EU): host smtp.zoho.eu, port 465. App password from Zoho security settings.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=info@ospitara.de
SMTP_PASS=your_zoho_app_password
MAIL_FROM=Ospitara <info@ospitara.de>
